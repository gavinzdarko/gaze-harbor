{
  "name": "gaze-harbor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "dev": "vite --host localhost",
    "build": "node scripts/copy-vendor.mjs && vite build",
    "preview": "vite preview --host localhost",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "webgazer": "3.5.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.4"
  }
}
